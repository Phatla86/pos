# CỔNG CHẠY SERVER
PORT=8080

# KẾT NỐI POSTGRESQL (Hỗ trợ Localhost, Supabase, Neon.tech, Render PostgreSQL)
# Ví dụ Local: postgresql://postgres:postgres@localhost:5432/cafepos
# Ví dụ Supabase: postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Ví dụ Neon: postgresql://neondb_owner:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cafepos

# CẤU HÌNH BẢO MẬT & CORS (Địa chỉ giao diện Next.js)
CLIENT_ORIGIN=http://localhost:3000

# MẬT KHẨU HOẶC KHÓA BẢO VỆ NẾU CẦN
NODE_ENV=development
